<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to list every installed app in the archive (sideloaded APK, so this is fine) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Needed for the Uninstall button in the long-press menu -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only used by the Solar phase widget, and only after you tap to allow it -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Only used by the Weather widget, to ask open-meteo.com for the forecast. Nothing else in Brassworks goes online -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used by the Agenda widget, and only after you tap Allow. The calendar is read on the phone and goes nowhere -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Lets the Countdown widget ring with a notification. Asked once, the first time you start a timer or alarm -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Brassworks">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustPan"
            android:taskAffinity="">
            <!-- This is what makes Android offer it as a Home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wakes up when a Countdown timer or alarm is due, so it can ring even if the launcher is closed -->
        <receiver
            android:name=".TimerReceiver"
            android:exported="false" />

        <!-- Lets Brassworks appear under Notification access, so the Music player can show the current track.
             It does nothing on its own and never reads your notifications. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
