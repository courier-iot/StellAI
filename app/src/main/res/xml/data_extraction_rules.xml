<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing from StellAI goes into Google's cloud backup or a phone-to-phone transfer: the server address and
     API key stay on this phone, and chats come back from your own server after pairing. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
