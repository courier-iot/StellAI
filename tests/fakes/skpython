#!/usr/bin/env python3
# fake SKiDL python: "runs" the circuit by reading Part(...) lines
import sys, json, os, re
if len(sys.argv)>2 and sys.argv[1]=="-c": sys.exit(0)
job=json.load(open(os.environ["STELLAI_JOB"]))
code=job["code"]
if "boom" in code:
    print("@@SKIDL@@"+json.dumps({"ok":False,"error":"NameError: boom","where":["line 3: boom()"]})); sys.exit()
parts=[]
for i,m in enumerate(re.finditer(r"Part\('(\w+)',\s*'([\w.-]+)'[^)]*?footprint='([^']*)'", code)):
    lib,name,fp=m.groups(); ref={"R":"R","LED":"D","AMS1117-3.3":"U"}.get(name,"J")+str(i+1)
    parts.append({"ref":ref,"name":name,"value":name,"footprint":fp,"pins":["1:~","2:~"],"unconnected":[]})
open(job["netlist"],"w").write(json.dumps(parts))
if job.get("schematic_dir"): open(os.path.join(job["schematic_dir"],job["name"]+".kicad_sch"),"w").write("(kicad_sch)")
print("@@SKIDL@@"+json.dumps({"ok":True,"parts":parts,"nets":[{"name":"VCC"},{"name":"GND"}],"erc":"","schematic":True}))
