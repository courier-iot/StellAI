#!/usr/bin/env python3
import sys, json, os
if len(sys.argv)>2 and sys.argv[1]=="-c": sys.exit(0)
job=json.load(open(os.environ["STELLAI_JOB"]))
b=job["board"]
st={"footprints":[],"tracks":0,"vias":0,"zones":0,"nets":0,"copper_layers":2,"board_mm":[50,30]}
if not job.get("new") and os.path.exists(b) and os.path.getsize(b)>2: st=json.load(open(b))
out={"ok":True}
if job.get("netlist"):
    parts=json.load(open(job["netlist"]))
    st["footprints"]=[{"ref":p["ref"],"value":p["value"],"footprint":p["footprint"],"x_mm":10+15*i,"y_mm":10,"rot_deg":0,"side":"top"} for i,p in enumerate(parts)]
    st["nets"]=2
    out["built"]={"placed":len(parts),"nets":2,"kept_places":1 if job.get("keep_from") else 0}
if job.get("dsn"): open(job["dsn"],"w").write("(pcb)"); out["dsn"]=True
if job.get("import_ses"): st["tracks"]=12; out["routed"]=os.path.exists(job["ses"])
out["after"]=st
if job.get("save"): json.dump(st,open(b,"w"))
print("@@PCB@@"+json.dumps(out))
